# Optional. The app loads these from the website's /api/mobile/config when it starts,
# so a normal build needs none of them. Set them only to point a build somewhere else
# or as a fallback if that endpoint can't be reached.
EXPO_PUBLIC_SITE_URL=https://tafritessy.vercel.app
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
